# apps/web — production build env (loaded by `vite build`).
#
# Every value here is CLIENT-PUBLIC: Vite inlines VITE_* into the bundle. No
# secrets. Override per-deploy with your host's build variables.

# ── Backend (apps/server) ───────────────────────────────────────────────────
# Point these at your deployed server. Left as the localhost defaults so a
# `bun build` on a fresh clone produces a bundle that works against a local
# server rather than silently calling a host that no longer exists.
VITE_SERVER_HTTP_URL=http://localhost:3001
VITE_SERVER_WS_URL=ws://localhost:3001/ws

# ── Somnia Shannon testnet (chain 50312) ────────────────────────────────────
VITE_SOMNIA_CHAIN_ID=50312
VITE_SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# ── Deployed contracts (see deployments/somnia-testnet.json) ────────────────
VITE_DREAMSWIPE_DUEL_ADDRESS=0x6b554BaFC2031b72AeB100cDAd111c2f70f2cC5c
VITE_SEASON_POOL_ADDRESS=0xB380814066dcb5d0b4d4968742bFdC005D1FB4a7

# Collateral: tUSDC, 6 DECIMALS on testnet. USDso (18 decimals) is mainnet
# only — the two differ by 10^12 and nothing reverts to warn you, so the app
# reads decimals() from the token rather than trusting a literal.
VITE_COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E

# Only testnet is offered: DreamDEX event contracts are testnet-only, so a
# mainnet entry in the picker would lead nowhere.
VITE_SUI_NETWORKS=testnet
