{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test src/lib src/ws src/db.test.ts src/deckmaster.test.ts src/mmr.test.ts src/avatar-icons.test.ts src/avatar-api.test.ts src/network-env.test.ts src/env.test.ts --timeout 10000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clear:duels": "bun run src/scripts/clear-duels.ts",
    "backfill:ratings": "bun run src/scripts/backfill-ratings.ts",
    "season:results": "bun run src/scripts/season-results.ts",
    "check:sources": "bun run src/scripts/check-sources.ts",
    "check:dreamdex": "bun run src/scripts/check-dreamdex.ts",
    "e2e:somnia": "bun run src/scripts/e2e-somnia.ts"
  },
  "dependencies": {
    "@workspace/dreamdex": "workspace:*",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
