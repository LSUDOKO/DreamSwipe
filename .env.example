# DreamSwipe — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env` or any key material.
# Everything here is either public config or a value you supply locally.
#
# Convention: FOO = testnet, FOO_MAINNET = mainnet. Mainnet NEVER falls back to
# a testnet value — a wrong address on mainnet is how you sign against the
# wrong chain. An empty string counts as unset.

# ═══════════════════════════════════════════════════════════════════════════
# Somnia network
# ═══════════════════════════════════════════════════════════════════════════
# Shannon testnet, chain 50312. Verified live: eth_chainId -> 0xc488.
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_CHAIN_ID=50312
SOMNIA_EXPLORER_URL=https://shannon-explorer.somnia.network

# DreamDEX event-contract indexer (GraphQL).
#
# NOTE: market discovery in this app deliberately does NOT depend on the
# indexer — it scans `MarketCreated` logs on chain — because this project
# already lost ~12 days of playability to a third-party read API being torn
# down. The SDK still requires a URL at construction.
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# ═══════════════════════════════════════════════════════════════════════════
# Keys — LOCAL ONLY, never committed
# ═══════════════════════════════════════════════════════════════════════════
# Deployer key for `forge script`. Needs STT for gas.
# Get testnet STT + tUSDC from the SomniaHacks dev group (faucet topic):
#   https://t.me/+XHq0F0JXMyhmMzM0
PRIVATE_KEY=

# Keeper: reveals decks and settles cards. Defaults to the deployer on first
# deploy; rotate afterwards with `setKeeper`.
#
# Scope note: the keeper CANNOT move escrow to an arbitrary address. Payouts
# are computed from recorded swipes and can only reach the two players.
KEEPER=
KEEPER_PRIVATE_KEY=

# Relayer: submits EIP-712-signed swipes so players never see a wallet popup.
# It cannot forge or replay a swipe — signatures bind
# (duelId, cardIdx, direction, nonce, deadline).
RELAYER_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Deployed contracts (fill in after `forge script script/Deploy.s.sol`)
# ═══════════════════════════════════════════════════════════════════════════
DREAMSWIPE_DUEL_ADDRESS=
SEASON_PRIZE_POOL_ADDRESS=

# Collateral. On Shannon testnet this is tUSDC at 6 DECIMALS — NOT USDso at 18.
# USDso is mainnet-only. The two differ by 10^12 and nothing reverts to warn
# you, so the app derives scale from the collateral's own `decimals()` rather
# than a literal. This value is only a discovery filter.
COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E

# ═══════════════════════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════════════════════
PORT=3001
DATABASE_URL=
ALLOWED_ORIGIN=

# Deck source: `dreamdex` (live event contracts) or `auto` (falls back when
# the venue has too few live windows).
DECK_SOURCE=dreamdex

# ═══════════════════════════════════════════════════════════════════════════
# Web (Vite inlines VITE_* into the client bundle — public values only)
# ═══════════════════════════════════════════════════════════════════════════
VITE_SERVER_HTTP_URL=http://localhost:3001
VITE_SERVER_WS_URL=ws://localhost:3001/ws
VITE_SOMNIA_CHAIN_ID=50312
VITE_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
VITE_DREAMSWIPE_DUEL_ADDRESS=
VITE_COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
